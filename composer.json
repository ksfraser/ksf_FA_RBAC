{
    "name": "ksfraser/ksf-fa-rbac",
    "description": "FrontAccounting adapter for RBAC — Voter-based authorization, role/permission hierarchy, and FA hook integration.",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "laminas/laminas-permissions-rbac": "^2.9 || ^3.0",
        "defuse/php-encryption": "^2.3",
        "ksfraser/exceptions": "*",
        "ksfraser/traits": "^1.2",
        "ksfraser/ksf-common-db": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\FrontAccounting\\Rbac\\": "src/Ksfraser/FrontAccounting/Rbac/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\FrontAccounting\\Rbac\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
